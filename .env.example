# Supabase Configuration (Project Settings -> API)
# Both values are safe to expose: all access is governed by Supabase Auth + row level security.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_your-key-here

# Without these two variables the app runs in single-device, local-only mode.
# On Vercel, the Supabase integration's SUPABASE_URL / SUPABASE_ANON_KEY are accepted as well.

# Server-only (never NEXT_PUBLIC_; not used by the app itself)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
